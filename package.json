{
  "name": "stv-hugowriter",
  "productName": "STV-HugoWriter",
  "version": "1.1.0-beta.2",
  "description": "だれでも簡単に使える Hugo ライター & ジェネレーター",
  "main": "electron/main.js",
  "author": "Small Travelers",
  "license": "MIT",
  "homepage": "https://github.com/Small-Travelers/STV-HugoWriter",
  "repository": {
    "type": "git",
    "url": "https://github.com/Small-Travelers/STV-HugoWriter.git"
  },
  "private": true,
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm:dev:renderer\" \"wait-on tcp:5173 && npm run dev:electron\"",
    "build:renderer": "vite build",
    "start": "electron .",
    "dist": "npm run build:renderer && electron-builder --win"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "basic-ftp": "^6.2.1",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@toast-ui/editor": "^3.2.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "ftp-srv": "^4.6.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "jp.wpgen.hugowriter",
    "productName": "STV-HugoWriter",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "licenses/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
